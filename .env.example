# ============================================
# KINTARA BOT — isi 2 baris di bawah ini saja
# ============================================

# Private key wallet Kintara kamu (base58 Solana, 64 byte)
WALLET_PRIVATE_KEY=IsiPrivateKeyBase58KamuDisini

# Token bot Telegram (chat @BotFather -> /newbot -> copy token)
TELEGRAM_BOT_TOKEN=123456:IsiTokenBotFatherDisini

# OPSIONAL — biarkan kosong kalau gak tau:
# TELEGRAM_CHAT_ID=        # auto-terekam saat kamu kirim command pertama
# KINTARA_FORCE_SERVER=    # paksa server, contoh: 15
