# ============================================
# KINTARA BOT — ENVIRONMENT (.env)
# Copy file ini jadi ".env" lalu isi nilainya
# ============================================

# --- WAJIB: wallet Kintara ---
# Private key wallet akun game kamu (yang dipakai login kintara.com)
WALLET_PRIVATE_KEY=0xIsiPrivateKeyKamuDisini

# --- WAJIB: Telegram bot ---
# 1. Chat @BotFather di Telegram → /newbot → ikuti langkahnya
# 2. Taruh token hasilnya di sini
TELEGRAM_BOT_TOKEN=123456:IsiTokenBotFatherDisini

# --- OPSIONAL: chat ID (auto-terekam saat kamu kirim command pertama) ---
# TELEGRAM_CHAT_ID=

# --- OPSIONAL: infra (default udah di-set otomatis) ---
# KINTARA_API_BASE=https://kintara.com
# KINTARA_SPEED=1.5        # multiplier jeda antar aksi (1.0 = normal, 1.5 = lebih cepat)
# KINTARA_PHASE_MAX_MIN=90 # durasi maks 1 fase /auto sebelum pindah (menit)
# KINTARA_FORCE_SHARD=s2   # pilih shard manual (s2 = node terbanyak)
